[Unit]
Description=HomeSIEM - lightweight router SIEM
After=network-online.target
Wants=network-online.target

[Service]
User=homesiem
WorkingDirectory=/opt/homesiem
ExecStart=/usr/bin/python3 /opt/homesiem/homesiem.py
Restart=always
RestartSec=5
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/homesiem/data

[Install]
WantedBy=multi-user.target
